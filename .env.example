# PostgreSQL — base de datos principal
# Ejemplo local: postgresql://postgres:password@localhost:5432/eventcorp_dev
DATABASE_URL="postgresql://usuario:password@localhost:5432/eventcorp_dev"

# Conexión directa usada por el CLI de Prisma (migraciones). En local suele ser igual a DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@localhost:5432/eventcorp_dev"

# Base de datos exclusiva para tests de integración (nunca apuntar a dev/prod)
TEST_DATABASE_URL="postgresql://usuario:password@localhost:5432/eventcorp_test"

# Clave secreta para firmar las cookies de sesión (cambiar en producción)
AUTH_SECRET="cambiar-por-clave-aleatoria-segura-en-produccion"

# Usuario administrador inicial (creado automáticamente si la tabla usuarios está vacía)
ADMIN_INITIAL_USER="admin"
ADMIN_INITIAL_EMAIL="admin@eventcorp.local"
ADMIN_INITIAL_PASSWORD="Admin123!"
