// EventCorpApp — esquema Prisma 7
// La URL de conexión vive en prisma.config.ts (datasource.url), no aquí.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id            String     @id @default(uuid()) @db.Uuid
  codigo        String     @unique @db.VarChar(20)
  nombre        String     @db.VarChar(150)
  clasificacion String?    @db.VarChar(50)
  ubicacion     String?    @db.VarChar(200)
  activo        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  empleados Empleado[]
  eventos   EventoEmpresa[]

  @@index([activo])
  @@map("empresas")
}

model Empleado {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  codigo         String    @db.VarChar(20)
  identificacion String?   @unique @db.VarChar(30)
  nombres        String    @db.VarChar(100)
  apellidos      String    @db.VarChar(100)
  correo         String    @unique @db.VarChar(200)
  departamento   String?   @db.VarChar(100)
  puesto         String?   @db.VarChar(100)
  zona           String?   @db.VarChar(100)
  clasificacion  String?   @db.VarChar(50)
  fechaIngreso   DateTime  @map("fecha_ingreso") @db.Date
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  participaciones EventoParticipante[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([apellidos, nombres])
  @@map("empleados")
}

enum EventoEstado {
  BORRADOR
  ACTIVO
  FINALIZADO
  CANCELADO
}

model Evento {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique @db.VarChar(20)
  nombre      String       @db.VarChar(150)
  descripcion String?      @db.VarChar(1000)
  ubicacion   String?      @db.VarChar(200)
  fechaInicio DateTime     @map("fecha_inicio")
  fechaFin    DateTime     @map("fecha_fin")
  estado      EventoEstado @default(BORRADOR)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  empresas    EventoEmpresa[]
  sorteos     Sorteo[]
  ejecuciones SorteoEjecucion[]

  @@index([estado])
  @@index([fechaInicio])
  @@map("eventos")
}

model EventoEmpresa {
  eventoId  String   @map("evento_id") @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id])

  participantes EventoParticipante[]

  @@id([eventoId, empresaId])
  @@index([empresaId])
  @@map("evento_empresas")
}

model EventoParticipante {
  id               String    @id @default(uuid()) @db.Uuid
  eventoId         String    @map("evento_id") @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  empleadoId       String    @map("empleado_id") @db.Uuid
  participaSorteos Boolean   @default(true) @map("participa_sorteos")
  exclusionMotivo  String?   @map("exclusion_motivo") @db.VarChar(300)
  exclusionAt      DateTime? @map("exclusion_at")
  exclusionPor     String?   @map("exclusion_por") @db.VarChar(150)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  eventoEmpresa EventoEmpresa @relation(fields: [eventoId, empresaId], references: [eventoId, empresaId], onDelete: Restrict)
  empleado      Empleado      @relation(fields: [empleadoId], references: [id])
  asistencia    Asistencia?
  ganadores     SorteoGanador[]

  @@unique([eventoId, empleadoId])
  @@index([eventoId, participaSorteos])
  @@index([empleadoId])
  @@map("evento_participantes")
}

model Asistencia {
  id                   String   @id @default(uuid()) @db.Uuid
  eventoParticipanteId String   @unique @map("evento_participante_id") @db.Uuid
  registradoAt         DateTime @default(now()) @map("registrado_at")
  registradoPor        String?  @map("registrado_por") @db.VarChar(150)

  participante EventoParticipante @relation(fields: [eventoParticipanteId], references: [id], onDelete: Restrict)

  @@map("asistencias")
}

enum SorteoEstado {
  BORRADOR
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum ReglaEntidad {
  EMPRESA
  EMPLEADO
}

enum ReglaOperador {
  IGUAL
  DISTINTO
  CONTIENE
  ANTES_DE
  DESPUES_DE
}

model Sorteo {
  id                    String       @id @default(uuid()) @db.Uuid
  eventoId              String       @map("evento_id") @db.Uuid
  nombre                String       @db.VarChar(150)
  descripcion           String?      @db.VarChar(500)
  cantidadGanadores     Int          @map("cantidad_ganadores")
  orden                 Int          @default(0)
  estado                SorteoEstado @default(BORRADOR)
  asistenciaObligatoria Boolean      @default(true) @map("asistencia_obligatoria")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  evento      Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  reglas      SorteoRegla[]
  ejecuciones SorteoEjecucion[]

  @@index([eventoId, estado])
  @@map("sorteos")
}

model SorteoRegla {
  id        String        @id @default(uuid()) @db.Uuid
  sorteoId  String        @map("sorteo_id") @db.Uuid
  entidad   ReglaEntidad
  campo     String        @db.VarChar(50)
  operador  ReglaOperador
  valor     String        @db.VarChar(300)
  orden     Int           @default(0)
  activo    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  sorteo Sorteo @relation(fields: [sorteoId], references: [id], onDelete: Cascade)

  @@index([sorteoId, activo])
  @@map("sorteo_reglas")
}

enum SorteoEjecucionEstado {
  COMPLETADA
  FALLIDA
}

model SorteoEjecucion {
  id                 String                @id @default(uuid()) @db.Uuid
  sorteoId           String                @map("sorteo_id") @db.Uuid
  eventoId           String                @map("evento_id") @db.Uuid
  estado             SorteoEjecucionEstado
  cantidadSolicitada Int                   @map("cantidad_solicitada")
  totalCandidatos    Int                   @map("total_candidatos")
  reglasSnapshot     Json                  @map("reglas_snapshot")
  candidatosSnapshot Json                  @map("candidatos_snapshot")
  error              String?               @db.VarChar(500)
  ejecutadoAt        DateTime              @default(now()) @map("ejecutado_at")
  ejecutadoPor       String?               @map("ejecutado_por") @db.VarChar(150)

  sorteo    Sorteo          @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  evento    Evento          @relation(fields: [eventoId], references: [id])
  ganadores SorteoGanador[]

  @@index([sorteoId, estado])
  @@index([eventoId])
  @@map("sorteo_ejecuciones")
}

model SorteoGanador {
  id          String   @id @default(uuid()) @db.Uuid
  ejecucionId String   @map("ejecucion_id") @db.Uuid
  eventoId    String   @map("evento_id") @db.Uuid
  empleadoId  String   @map("empleado_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  ejecucion    SorteoEjecucion    @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
  participante EventoParticipante @relation(fields: [eventoId, empleadoId], references: [eventoId, empleadoId], onDelete: Restrict)

  @@unique([eventoId, empleadoId])
  @@index([ejecucionId])
  @@map("sorteo_ganadores")
}

model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  eventoId  String?  @map("evento_id") @db.Uuid
  entidad   String   @db.VarChar(50)
  entidadId String?  @map("entidad_id") @db.VarChar(60)
  accion    String   @db.VarChar(50)
  actor     String?  @db.VarChar(150)
  antes     Json?
  despues   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventoId, createdAt])
  @@index([entidad, entidadId])
  @@map("auditoria")
}
